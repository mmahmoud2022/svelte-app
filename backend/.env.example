# Application
ENVIRONMENT=development
SECRET_KEY=your-secret-key-change-in-production-min-32-characters-long
ADMIN_SECRET=ADMIN_SECRET_2025_CHANGE_IN_PRODUCTION

# Database
DATABASE_URL=postgresql://sante_user:sante_password@localhost:5432/sante_db

# Redis
REDIS_URL=redis://localhost:6379/0

# Email Configuration
EMAIL_ENABLED=true
EMAIL_PROVIDER=smtp  # "smtp" for development (Mailpit) or "ses" for production (Amazon SES)
EMAIL_FROM=noreply@sante-app.com
EMAIL_FROM_NAME=Santé Medical

# SMTP Configuration (Mailpit for development)
# When running with Docker Compose, use "mailpit" as host
# When running locally, use "localhost"
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=false
SMTP_SSL=false

# Amazon SES Configuration (for production)
# Uncomment and configure when using SES
# EMAIL_PROVIDER=ses
# AWS_SES_REGION=us-east-1
# AWS_SES_ACCESS_KEY_ID=your-aws-access-key-id
# AWS_SES_SECRET_ACCESS_KEY=your-aws-secret-access-key
# AWS_SES_CONFIGURATION_SET=  # Optional: for tracking

# AWS S3 (optional for file storage)
AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_BUCKET=

# Frontend/Backend URLs
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# OAuth2 (optional)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# SMS (optional - Twilio)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=

# Payment (optional - Stripe)
# STRIPE_PUBLIC_KEY=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# Telemedicine (optional)
# VIDEO_CALL_API_KEY=
# VIDEO_CALL_API_SECRET=
